# The .gitattributes file allows file attributes to be specified for git actions
# that involve creating or modifying files, such as cloning a repo or committing
# a new file. These attributes can vary with the platform.
#
# Git reads this file and uses the directives to set the attributes, like which
# line endings to use or if the file should be treated as a binary.
#
# These directives also allow files to be normalized across platofroms, so, for
# example, a script created on a Windows machine intended for use in a Linux
# virtual environment will have the right line endings when the repo is cloned
# into the Linux environment.

# All files are checked into the repo with LF.
*text=auto
# These files are checked out using LF locally.
*.sh eol=LF
*.sh -crlf
# These files are checked out using CFLF locally.
*.bat eol=crlf
# LFS File extensions:
*.bmp filter=lfs diff=lfs merge=lfs -text
*.doc filter=lfs diff=lfs merge=lfs -text
*.docm filter=lfs diff=lfs merge=lfs -text
*.docx filter=lfs diff=lfs merge=lfs -text
